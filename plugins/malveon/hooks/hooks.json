{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --prefer-offline -y malveon@0.5.7 hook prompt --agent claude",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --prefer-offline -y malveon@0.5.7 hook stop --agent claude --mode enforce",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
